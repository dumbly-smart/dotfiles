# Ax-Shell / Waybar Material palette.
sort=-time
layer=overlay
anchor=top-right
width=390
height=110
margin=10
outer-margin=4
padding=12
border-size=1
border-color=#393939
border-radius=10
background-color=#131313f2
text-color=#e2e2e2
font=Iosevka Nerd Font 13
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0
history=1
max-history=50
markup=1
format=<b>%s</b>\n%b
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all

[urgency=low]
border-color=#919191
default-timeout=3000

[urgency=normal]
border-color=#393939

[urgency=high]
border-color=#ffffff
default-timeout=0
