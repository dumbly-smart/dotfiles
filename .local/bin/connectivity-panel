#!/usr/bin/env python3
"""A small niri-friendly Wi-Fi/Bluetooth panel with a dark Berserk mood."""

from __future__ import annotations

import html
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk


CSS = """
window { background: #000000; color: #ffffff; }
headerbar { background: #000000; border-bottom: 1px solid #444444; min-height: 52px; }
headerbar title { color: #ffffff; font-family: Iosevka Nerd Font; font-weight: 800; letter-spacing: 1px; }
.subtitle { color: #999999; font-size: 11px; letter-spacing: 2px; }
.section-title { color: #ffffff; font-size: 18px; font-weight: 800; letter-spacing: 1px; }
.section-copy { color: #999999; font-size: 12px; }
.status { color: #ffffff; background: #111111; border: 1px solid #444444; border-radius: 6px; padding: 12px; }
button { color: #ffffff; background: #111111; border: 1px solid #555555; border-radius: 6px; padding: 10px 12px; }
button:hover { color: #ffffff; background: #222222; border-color: #ffffff; }
button.scarlet { color: #000000; background: #ffffff; border-color: #ffffff; }
button.scarlet:hover { color: #ffffff; background: #333333; }
list { background: transparent; }
row { margin: 3px 0; }
separator { background: #444444; margin: 12px 0; }
tab { color: #999999; padding: 8px 18px; }
tab:checked { color: #ffffff; }
"""


def command(*args: str) -> tuple[int, str]:
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=8)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return 1, str(exc)
    return result.returncode, result.stdout.strip()


class ConnectivityPanel(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id="dev.xtrmn8.ConnectivityPanel")
        self.window: Gtk.ApplicationWindow | None = None
        self.status: Gtk.Label | None = None
        self.wifi_list: Gtk.ListBox | None = None
        self.bluetooth_list: Gtk.ListBox | None = None
        self.bluetooth_power: Gtk.Button | None = None

    def do_activate(self) -> None:
        if self.window is not None:
            self.window.present()
            self.refresh_all()
            return

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("Connectivity // Black Swordsman")
        self.window.set_default_size(540, 650)
        self.window.set_resizable(False)

        header = Gtk.HeaderBar()
        title = Gtk.Label(label="CONNECTIVITY")
        title.add_css_class("title")
        header.set_title_widget(title)
        self.window.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.set_margin_top(18)
        root.set_margin_bottom(18)
        root.set_margin_start(20)
        root.set_margin_end(20)

        subtitle = Gtk.Label(label="BLACK SWORD // NETWORK & DEVICES")
        subtitle.add_css_class("subtitle")
        subtitle.set_halign(Gtk.Align.START)
        root.append(subtitle)

        self.status = Gtk.Label(label="Reading system state…")
        self.status.set_halign(Gtk.Align.FILL)
        self.status.set_margin_top(14)
        self.status.add_css_class("status")
        root.append(self.status)

        stack = Gtk.Stack()
        stack.set_vexpand(True)
        switcher = Gtk.StackSwitcher()
        switcher.set_stack(stack)
        switcher.set_halign(Gtk.Align.CENTER)
        switcher.set_margin_top(16)
        switcher.set_margin_bottom(8)
        root.append(switcher)

        wifi_page = self.make_wifi_page()
        bluetooth_page = self.make_bluetooth_page()
        stack.add_titled(wifi_page, "wifi", "Wi-Fi")
        stack.add_titled(bluetooth_page, "bluetooth", "Bluetooth")

        self.window.set_child(root)
        self.install_css()
        self.window.present()
        self.refresh_all()

    def install_css(self) -> None:
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

    def make_wifi_page(self) -> Gtk.Box:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        heading = Gtk.Label(label="WIRELESS SIGNAL")
        heading.add_css_class("section-title")
        heading.set_halign(Gtk.Align.START)
        page.append(heading)
        copy = Gtk.Label(label="Select a network to connect. Saved networks connect instantly.")
        copy.add_css_class("section-copy")
        copy.set_halign(Gtk.Align.START)
        page.append(copy)
        refresh = Gtk.Button(label="↻  RESCAN NETWORKS")
        refresh.add_css_class("scarlet")
        refresh.set_halign(Gtk.Align.START)
        refresh.connect("clicked", lambda *_: self.refresh_wifi())
        page.append(refresh)
        self.wifi_list = Gtk.ListBox()
        self.wifi_list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.wifi_list.set_vexpand(True)
        page.append(self.wifi_list)
        return page

    def make_bluetooth_page(self) -> Gtk.Box:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        heading = Gtk.Label(label="IRON DEVICES")
        heading.add_css_class("section-title")
        heading.set_halign(Gtk.Align.START)
        page.append(heading)
        copy = Gtk.Label(label="Pairing and device management are handled through BlueZ.")
        copy.add_css_class("section-copy")
        copy.set_halign(Gtk.Align.START)
        page.append(copy)
        controls = Gtk.Box(spacing=8)
        self.bluetooth_power = Gtk.Button(label="POWER")
        self.bluetooth_power.add_css_class("scarlet")
        self.bluetooth_power.connect("clicked", lambda *_: self.toggle_bluetooth())
        controls.append(self.bluetooth_power)
        scan = Gtk.Button(label="SCAN DEVICES")
        scan.connect("clicked", lambda *_: self.scan_bluetooth())
        controls.append(scan)
        manager = Gtk.Button(label="OPEN BLUEMAN")
        manager.connect("clicked", lambda *_: subprocess.Popen(["blueman-manager"]))
        controls.append(manager)
        page.append(controls)
        self.bluetooth_list = Gtk.ListBox()
        self.bluetooth_list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.bluetooth_list.set_vexpand(True)
        page.append(self.bluetooth_list)
        return page

    @staticmethod
    def clear_list(widget: Gtk.ListBox | None) -> None:
        if widget is None:
            return
        while child := widget.get_first_child():
            widget.remove(child)

    def refresh_all(self) -> None:
        self.refresh_wifi()
        self.refresh_bluetooth()

    def refresh_wifi(self) -> None:
        threading.Thread(target=self._refresh_wifi_worker, daemon=True).start()

    def _refresh_wifi_worker(self) -> None:
        code, output = command("nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi")
        GLib.idle_add(self._apply_wifi, code, output)

    def _apply_wifi(self, code: int, output: str) -> bool:
        self.clear_list(self.wifi_list)
        if code:
            self.set_status("Wi-Fi unavailable — NetworkManager may be stopped.")
            return False
        active = "disconnected"
        for row in output.splitlines():
            parts = row.split(":", 3)
            if len(parts) != 4:
                continue
            in_use, ssid, signal, security = [part.replace("\\:", ":") for part in parts]
            if not ssid:
                continue
            if in_use == "*":
                active = ssid
            label = f"{'●' if in_use == '*' else '○'}  {ssid}    {signal}%    {security or 'open'}"
            button = Gtk.Button(label=label)
            button.set_halign(Gtk.Align.FILL)
            button.connect("clicked", lambda *_args, name=ssid: self.connect_wifi(name))
            self.wifi_list.append(button) if self.wifi_list else None
        self.set_status(f"Wi-Fi  //  {active}")
        return False

    def connect_wifi(self, ssid: str) -> None:
        def worker() -> None:
            code, _ = command("nmcli", "dev", "wifi", "connect", ssid)
            GLib.idle_add(self._finish_wifi_connection, code, ssid)

        threading.Thread(target=worker, daemon=True).start()

    def _finish_wifi_connection(self, code: int, ssid: str) -> bool:
        if code:
            self.set_status(f"Could not connect to {ssid}. Open NetworkManager for secured networks.")
            subprocess.Popen(["nm-connection-editor"])
        else:
            self.set_status(f"Connected to {ssid}")
        GLib.timeout_add(1200, self.refresh_wifi)
        return False

    def refresh_bluetooth(self) -> None:
        threading.Thread(target=self._refresh_bluetooth_worker, daemon=True).start()

    def _refresh_bluetooth_worker(self) -> None:
        _, power = command("bluetoothctl", "show")
        powered = "Powered: yes" in power
        code, output = command("bluetoothctl", "devices")
        devices = []
        if not code:
            for row in output.splitlines():
                match = row.split(" ", 2)
                if len(match) < 3:
                    continue
                _, address, name = match
                info_code, info = command("bluetoothctl", "info", address)
                devices.append((address, name, info_code == 0 and "Connected: yes" in info))
        GLib.idle_add(self._apply_bluetooth, powered, code, devices)

    def _apply_bluetooth(self, powered: bool, code: int, devices: list[tuple[str, str, bool]]) -> bool:
        if self.bluetooth_power:
            self.bluetooth_power.set_label("POWER ON" if powered else "POWER OFF")
        self.clear_list(self.bluetooth_list)
        if code:
            self.set_status("Bluetooth unavailable — BlueZ may be stopped.")
            return False
        for address, name, connected in devices:
            button = Gtk.Button(label=f"{'●' if connected else '○'}  {name}  ·  {address}")
            button.connect(
                "clicked",
                lambda *_args, mac=address, is_connected=connected: self.toggle_device(mac, is_connected),
            )
            self.bluetooth_list.append(button) if self.bluetooth_list else None
        return False

    def toggle_bluetooth(self) -> None:
        def worker() -> None:
            _, output = command("bluetoothctl", "show")
            command("bluetoothctl", "power", "off" if "Powered: yes" in output else "on")
            GLib.idle_add(self.refresh_bluetooth)

        threading.Thread(target=worker, daemon=True).start()

    def scan_bluetooth(self) -> None:
        def worker() -> None:
            command("bluetoothctl", "scan", "on")
            GLib.idle_add(self._finish_bluetooth_scan)

        threading.Thread(target=worker, daemon=True).start()

    def _finish_bluetooth_scan(self) -> bool:
        self.set_status("Bluetooth scan started — refresh in a moment.")
        GLib.timeout_add(3500, self.refresh_bluetooth)
        return False

    def toggle_device(self, address: str, connected: bool) -> None:
        def worker() -> None:
            command("bluetoothctl", "disconnect" if connected else "connect", address)
            GLib.idle_add(self._finish_device_toggle)

        threading.Thread(target=worker, daemon=True).start()

    def _finish_device_toggle(self) -> bool:
        GLib.timeout_add(1000, self.refresh_bluetooth)
        return False

    def set_status(self, message: str) -> None:
        if self.status:
            self.status.set_markup(html.escape(message))


if __name__ == "__main__":
    if "--check" in sys.argv[1:]:
        required = ["nmcli", "bluetoothctl"]
        missing = [name for name in required if command("sh", "-c", f"command -v {name}")[0]]
        if missing:
            print(f"missing tools: {', '.join(missing)}", file=sys.stderr)
            raise SystemExit(1)
        print("connectivity panel dependencies available")
        raise SystemExit(0)
    ConnectivityPanel().run(sys.argv)
